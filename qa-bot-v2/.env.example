# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Runtime
QA_DRY_RUN=true
QA_REPORT_BASE_DIR=./reports

# ADB
ADB_PATH=/Users/liveanywhere_test/Library/Android/sdk/platform-tools/adb
ADB_GUEST_DEVICE=
ADB_HOST_DEVICE=

# Android packages
ANDROID_STAGING_PACKAGE=com.live1month.live1month.staging
ANDROID_DEV_PACKAGE=com.live1month.live1month.dev
ANDROID_PROD_PACKAGE=com.live1month.live1month

# Test accounts
GUEST_EMAIL=
GUEST_PASSWORD=
HOST_EMAIL=
HOST_PASSWORD=

# Optional coordinate fallbacks when uiautomator cannot identify Flutter controls.
# Format: x,y
LOGIN_DISMISS_UPDATE_LATER_TAP=
LOGIN_FIRST_LOGIN_TAP=
LOGIN_SUBMIT_TAP=
