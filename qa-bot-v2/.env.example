# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Optional. If set, command progress stays in the source thread but results/PDFs
# are posted to a new thread in this channel. Channel ID is safest, but a name
# such as 테스트-채널 also works when the bot has channel list permission.
SLACK_RESULT_CHANNEL=
# Comma-separated exact commands that may publish results to SLACK_RESULT_CHANNEL.
# Commands not listed here stay in the original command thread.
SLACK_RESULT_CHANNEL_ALLOWLIST=
# Default Slack user selected in the /검증 tester field (김대훈: U058U199W1W).
SLACK_DEFAULT_VALIDATION_TESTER_USER_ID=U058U199W1W

# Runtime
QA_DRY_RUN=true
QA_REPORT_BASE_DIR=./reports

# ADB
ADB_PATH=/Users/liveanywhere_test/Library/Android/sdk/platform-tools/adb
ADB_GUEST_DEVICE=
ADB_HOST_DEVICE=

# Android packages
ANDROID_STAGING_PACKAGE=com.live1month.live1month.staging
ANDROID_DEV_PACKAGE=com.live1month.live1month.dev
ANDROID_PROD_PACKAGE=com.live1month.live1month

# Optional app build precheck.
# When enabled for staging tests, the bot compares the installed app version with
# the latest Firebase App Distribution release. If AUTO_INSTALL_LATEST_STAGING=true,
# it downloads and installs the latest APK before running the test.
APP_BUILD_CHECK_ENABLED=false
AUTO_INSTALL_LATEST_STAGING=false
FIREBASE_PROJECT_NUMBER=326461175001
FIREBASE_STAGING_APP_ID=1:326461175001:android:c402489a89eb156bdc7ac8
FIREBASE_DEV_APP_ID=1:326461175001:android:2baa0e3b69b9d2e5dc7ac8
# Optional. Empty value uses the local `firebase login` session.
FIREBASE_SERVICE_ACCOUNT_PATH=
APP_BUILD_DOWNLOAD_DIR=.tmp/app-builds

# iOS build-install (xcrun devicectl, no WDA needed - cable install only)
FIREBASE_IOS_STAGING_APP_ID=1:326461175001:ios:41080c452762adb6dc7ac8
FIREBASE_IOS_DEV_APP_ID=1:326461175001:ios:aca77caf7eb5f48ddc7ac8
IOS_STAGING_BUNDLE_ID=com.live1month.live1month.staging
IOS_DEV_BUNDLE_ID=com.live1month.live1month.dev
# `xcrun devicectl list devices` 결과의 Identifier 컬럼 값
IOS_GUEST_DEVICE_ID=
IOS_HOST_DEVICE_ID=
# 로그인 등 화면 조작(UI 자동화)에는 devicectl이 아니라 WebDriverAgent(WDA)가 필요합니다.
# Xcode에서 WebDriverAgentRunner를 Product > Test로 실행해서 켜둔 뒤,
# 그 기기의 WDA HTTP 주소를 넣어주세요 (기본 포트는 보통 8100).
IOS_GUEST_WDA_URL=
IOS_HOST_WDA_URL=

# Test accounts
GUEST_EMAIL=
GUEST_PASSWORD=
GUEST_FALLBACK_EMAIL=
GUEST_FALLBACK_PASSWORD=
HOST_EMAIL=
HOST_PASSWORD=

# Toss Payments test admin. Keep real values only in local .env.
TOSS_ADMIN_URL=https://developers.tosspayments.com/3118/accounts/127851/phases/test/payment-logs
TOSS_ADMIN_MID=liveanjb2c
TOSS_ADMIN_EMAIL=
TOSS_ADMIN_PASSWORD=
TOSS_ADMIN_HEADLESS=true
TOSS_ADMIN_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
TOSS_ADMIN_PROFILE_DIR=.tmp/toss-admin-profile
TOSS_ADMIN_KEEP_OPEN_ON_FAIL=false

# LiveAnywhere console automation. By default, this reuses Toss admin credentials
# and opens Chrome visibly so the console action can be watched.
CONSOLE_DEV_URL_BASE=https://dev-console.liveanywhere.me/reservations
CONSOLE_STAGING_URL_BASE=https://staging-console.liveanywhere.me/reservations
CONSOLE_ADMIN_EMAIL=
CONSOLE_ADMIN_PASSWORD=
CONSOLE_ADMIN_HEADLESS=true
CONSOLE_ADMIN_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CONSOLE_ADMIN_PROFILE_DIR=.tmp/console-admin-profile
CONSOLE_ADMIN_KEEP_OPEN_ON_FAIL=false

# Optional coordinate fallbacks when uiautomator cannot identify Flutter controls.
# Format: x,y
LOGIN_DISMISS_UPDATE_LATER_TAP=
LOGIN_FIRST_LOGIN_TAP=
LOGIN_SUBMIT_TAP=
